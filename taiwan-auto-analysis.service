[Unit]
Description=台股自動分析系統 - 盤後盤前分析推送
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=aibot
Group=aibot
WorkingDirectory=/opt/taiwan-stock-ai-analyzer
ExecStart=/usr/bin/python3 /opt/taiwan-stock-ai-analyzer/auto_scheduler.py --schedule
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# 環境變數
Environment=PYTHONPATH=/opt/taiwan-stock-ai-analyzer:/opt/taiwan-stock-ai-analyzer/realtime_trading_system
Environment=TZ=Asia/Taipei

# 限制資源使用
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target